[Unit]
Description=Deterministic varied RCP demo fault drill
Requires=rcp-demo-drill-restore.service
After=rcp-demo-drill-restore.service

[Service]
Type=oneshot
WorkingDirectory=/opt/rcp/deploy/demo
ExecStart=/usr/bin/python3 /opt/rcp/deploy/demo/scripts/outage-drill.py scheduled
# Also restore after a forced termination, including SIGKILL.
ExecStopPost=/usr/bin/python3 /opt/rcp/deploy/demo/scripts/outage-drill.py restore
TimeoutStartSec=22min
TimeoutStopSec=30s
UMask=0022
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/rcp/deploy/demo/drill
