{
	email {$ACME_EMAIL}
	admin off
}

{$RCP_API_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
	# Metrics and health are available within Docker, not on the public API origin.
	@management path /actuator /actuator/*
	handle @management {
		respond "Not found" 404
	}
	handle {
		reverse_proxy control-plane:8080
	}
}
