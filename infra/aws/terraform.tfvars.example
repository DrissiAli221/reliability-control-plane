project_name           = "rcp"
environment            = "dev"
central_region         = "eu-west-1"
secondary_probe_region = "us-east-1"
probe_worker_timeout_seconds = 30
central_availability_zones = ["eu-west-1a", "eu-west-1b"]

# Development/reference posture. These must be reconsidered before durable use.
database_instance_class      = "db.t4g.micro"
database_multi_az            = false
database_deletion_protection = false
database_skip_final_snapshot = true

# The SPA uses authorization code + PKCE and therefore has no client secret.
# Replace the globally unique domain prefix and URLs before any authorized apply.
cognito_domain_prefix       = "rcp-dev-replace-before-apply"
cognito_callback_urls       = ["http://localhost:5173/auth/callback"]
cognito_logout_urls         = ["http://localhost:5173/"]
cognito_deletion_protection = false

# Plan-only placeholders. A real apply requires a validated ACM certificate and
# an immutable image tag that has already been pushed to the planned ECR repository.
control_plane_certificate_arn = "arn:aws:acm:eu-west-1:000000000000:certificate/00000000-0000-0000-0000-000000000000"
control_plane_image_tag       = "not-pushed"
control_plane_desired_count   = 0

# The offline plan does not inspect this object. A future apply requires a real,
# immutable artifact and should pin probe_worker_artifact_object_version.
probe_worker_artifact_bucket = "replace-with-versioned-artifact-bucket"
probe_worker_artifact_key    = "probe-worker/not-uploaded/rcp-probe-lambda.jar"

# Local validation/plan only. Leave false for any real AWS operation.
offline_mode = true
