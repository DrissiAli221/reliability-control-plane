name          = "rcp-demo"
account_id    = "123456789012" # Replace in an untracked terraform.tfvars.
budget_email  = "you@example.com"
api_origin    = "https://api.example.com"
# lambda_artifact_path defaults to ../../rcp-probe-lambda/target/rcp-probe-lambda.jar
# Offline mode must stay false for an eventual authorized deployment.

# Optional social sign-in. Leave social_providers empty to keep username/password only.
# These four values are secrets: keep them in the untracked terraform.tfvars (or TF_VAR_*).
social_providers     = [] # any of "Google", "GitHub"
google_client_id     = "000000000000-placeholder.apps.googleusercontent.com"
google_client_secret = "GOCSPX-placeholder"
github_client_id     = "Iv1.placeholder"
github_client_secret = "placeholder-github-client-secret"
